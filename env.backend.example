# --- Razorpay (Dashboard -> Settings -> API Keys, in TEST MODE) ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# --- Razorpay Webhook (Dashboard -> Settings -> Webhooks -> set your own secret) ---
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# --- Gemini (aistudio.google.com -> API Keys) ---
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
# Check AI Studio's dashboard for which model is CURRENTLY free-tier eligible
# for your project, and put that exact model ID here. Do not assume this value
# is still correct by the time you read it -- model lineups change. We ended up
# on gemini-3.5-flash-lite (500 req/day free tier) after the initially-listed
# gemini-3.x-flash models turned out to be capped at only 20 req/day.
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Database ---
DATABASE_URL=sqlite:///./agentic_commerce.db

# --- App ---
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000

# --- Tunnel for local Razorpay webhook testing ---
# ngrok's Windows build got flagged by Windows Defender as a trojan on this
# machine (both the winget package and the official direct download) -- we
# used Cloudflare's `cloudflared` quick tunnel instead. Either works; put
# whichever public HTTPS URL you're using here.
PUBLIC_BASE_URL=https://your-tunnel-subdomain.example.com
